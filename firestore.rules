rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow read and write for all app collections
    match /{document=**} {
      allow read, write: if true;
    }

    match /news/{id} {
      allow read, write: if true;
    }

    match /jobs/{id} {
      allow read, write: if true;
    }

    match /banners/{id} {
      allow read, write: if true;
    }

    match /gallery/{id} {
      allow read, write: if true;
    }

    match /leadership/{id} {
      allow read, write: if true;
    }

    match /faqs/{id} {
      allow read, write: if true;
    }

    match /links/{id} {
      allow read, write: if true;
    }

    match /heroSlides/{id} {
      allow read, write: if true;
    }

    match /featured_videos/{id} {
      allow read, write: if true;
    }

    match /messages/{id} {
      allow read, write: if true;
    }
  }
}
